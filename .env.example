# Required — get this from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Required — comma-separated Telegram user IDs of admins
# To find your ID, message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Required — your log channel (use @channelname or a numeric ID like -1001234567890)
LOG_CHANNEL=@YourLogChannel

# Optional — absolute path to gatekeeper.db if you are running the GateKeeper bot
# on the same server. Enables cross-reference warnings on /check.
# GATEKEEPER_DB_PATH=/home/botuser/gatekeeper/gatekeeper.db
