# Required — get this from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Required — comma-separated Telegram user IDs of admins
# To find your ID, message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Required — your log channel numeric ID (preferred) or @username
# Example: -1003817851175
LOG_CHANNEL=-1003817851175

# Optional — absolute path to gatekeeper.db on the server
# The GateKeeper bot runs from /home/ubuntu/gatekeeper (WorkingDirectory in its service)
# and uses a relative DB_PATH="gatekeeper.db", so the full path is:
GATEKEEPER_DB_PATH=/home/ubuntu/gatekeeper/gatekeeper.db
